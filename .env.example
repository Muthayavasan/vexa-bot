# ==============================================================================
# AI Chatbot Configuration (.env)
# Copy this file to .env and insert your API keys.
# ==============================================================================

# Anthropic Claude API Key (Recommended for Claude 3.5 Sonnet / Haiku / Opus)
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (For GPT-4o, GPT-4o-mini, etc.)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (Local models - No API key required by default!)
# Download Ollama from: https://ollama.com
# Run in terminal: `ollama pull llama3.2` (or `mistral`, `deepseek-r1:8b`, `phi3`)
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional: only if your Ollama instance is behind a proxy requiring an auth key:
OLLAMA_API_KEY=

# Optional: Company & Bot Customization
COMPANY_NAME="Aether Dynamics"
BOT_NAME="Nova AI"

# ==============================================================================
# Database Configuration (Supabase PostgreSQL / SQLite)
# ==============================================================================
# For local SQLite (Default if left empty):
# DATABASE_URL=sqlite:///backend/chatbot.db

# For Supabase PostgreSQL (replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF]):
# Transaction Pooler (Recommended for Render / Serverless):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct Connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

